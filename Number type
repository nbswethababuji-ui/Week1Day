function isnumbertype(n)
{
  if(n>0)
  {
    console.log("n is positive number")
  }
  else if(n<0)
  {
    console.log("n is negative number")
  }
  else if (n===0)
  {
    console.log("n is neutral")
  }
}
isnumbertype(-7);
isnumbertype(22);
isnumbertype(0);

